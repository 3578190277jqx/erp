# The Django process reads environment variables, not this file automatically.
# compose.yml reads .env; PowerShell/bash users set the variables in their shell.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://erp.example.com
DJANGO_SSL_REDIRECT=true
# For local Docker HTTP evaluation only: set DJANGO_DEBUG=true and
# DJANGO_SSL_REDIRECT=false. Production requires an HTTPS reverse proxy.
